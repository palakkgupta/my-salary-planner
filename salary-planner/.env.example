# Copy this file to .env and set your PostgreSQL values.
# This app uses one shared PostgreSQL database that you own.
# Each user's planner data is stored in a separate row (by user_id) in planner_states.
# Users do NOT create databases.
# You can use either DATABASE_URL or individual PG* variables.

# Option 1: single connection string
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/salary_planner
# Render managed PostgreSQL usually provides DATABASE_URL directly.
# In Render, also set PGSSLMODE=require.

# Option 2: split fields
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=salary_planner

# API server port
PORT=5050

# JWT secret for login sessions (set a long random value in production)
JWT_SECRET=replace-with-a-long-random-secret

# Set to 'require' if your DB needs SSL
PGSSLMODE=disable
